<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!--
      暫定: Core.Data 0.1.0 の推移依存で、IBM Db2・Firebird のドライバ（独自許諾・IDPL 1.0）が配布物へ入る。
      本アプリは使わないので、アセットを全て除外して publish の出力から外す。ネイティブの clidriver/ は、Worker の出力経由で Web の publish へ入る（Web は Worker を参照する）ため、Worker でも除外する。バージョンは推移依存の解決版に合わせる。
      Core 側が依存を絞った版（vehiclevisionjp/VehicleVision.PleasanterTools.Core#151）を取り込んだら、この 2 行を外す（Web・Data プロジェクトの同じ 2 行も）。
    -->
    <PackageReference Include="Net.IBM.Data.Db2" Version="9.0.0.300" ExcludeAssets="all" />
    <PackageReference Include="FirebirdSql.Data.FirebirdClient" Version="10.3.3" ExcludeAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VehicleVision.PleasanterTools.Questionnaire.Core\VehicleVision.PleasanterTools.Questionnaire.Core.csproj" />
    <ProjectReference Include="..\VehicleVision.PleasanterTools.Questionnaire.Data\VehicleVision.PleasanterTools.Questionnaire.Data.csproj" />
    <ProjectReference Include="..\VehicleVision.PleasanterTools.Questionnaire.Mail\VehicleVision.PleasanterTools.Questionnaire.Mail.csproj" />
    <ProjectReference Include="..\VehicleVision.PleasanterTools.Questionnaire.Pleasanter\VehicleVision.PleasanterTools.Questionnaire.Pleasanter.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- メール送信の部品は Core.Mail（NuGet）へ集約した。名前空間を暗黙に使えるようにする -->
    <Using Include="VehicleVision.PleasanterTools.Core.Mail" />
  </ItemGroup>

  <ItemGroup>
    <!-- DB の基盤は Core.Data（NuGet）へ集約した。名前空間を暗黙に使えるようにする -->
    <Using Include="VehicleVision.PleasanterTools.Core.Data" />
  </ItemGroup>

</Project>
