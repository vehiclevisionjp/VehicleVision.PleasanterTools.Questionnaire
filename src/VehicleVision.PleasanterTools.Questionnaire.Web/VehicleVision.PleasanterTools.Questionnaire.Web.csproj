<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <!-- パスワードのハッシュ（PBKDF2）は ASP.NET Core の共有フレームワークに含まれるため
         PackageReference は要らない（NU1510） -->
    <!-- TOTP（RFC 6238）。MIT。**自前で書かない** -->
    <!-- bot 対策の proof-of-work（Issue #55）。BSD-2-Clause -->
    <PackageReference Include="Ixnas.AltchaNet" Version="1.2.1" />
    <!-- 管理画面の SAML 2.0 ログイン（Issue #166）。BSD-3-Clause -->
    <PackageReference Include="ITfoxtec.Identity.Saml2" Version="4.21.0" />
    <PackageReference Include="ITfoxtec.Identity.Saml2.MvcCore" Version="4.21.0" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.104.2" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.30.1" />
    <PackageReference Include="nClam" Version="9.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Otp.NET" Version="1.4.1" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VehicleVision.PleasanterTools.Questionnaire.Core\VehicleVision.PleasanterTools.Questionnaire.Core.csproj" />
    <ProjectReference Include="..\VehicleVision.PleasanterTools.Questionnaire.Data\VehicleVision.PleasanterTools.Questionnaire.Data.csproj" />
    <ProjectReference Include="..\VehicleVision.PleasanterTools.Questionnaire.Mail\VehicleVision.PleasanterTools.Questionnaire.Mail.csproj" />
    <ProjectReference Include="..\VehicleVision.PleasanterTools.Questionnaire.Pleasanter\VehicleVision.PleasanterTools.Questionnaire.Pleasanter.csproj" />
    <ProjectReference Include="..\VehicleVision.PleasanterTools.Questionnaire.Scripting\VehicleVision.PleasanterTools.Questionnaire.Scripting.csproj" />
    <ProjectReference Include="..\VehicleVision.PleasanterTools.Questionnaire.Worker\VehicleVision.PleasanterTools.Questionnaire.Worker.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VehicleVision.PleasanterTools.Questionnaire.Web.Tests" />
    <InternalsVisibleTo Include="VehicleVision.PleasanterTools.Questionnaire.Integration.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- メール送信の部品は Core.Mail（NuGet）へ集約した。名前空間を暗黙に使えるようにする -->
    <Using Include="VehicleVision.PleasanterTools.Core.Mail" />
  </ItemGroup>

  <ItemGroup>
    <!-- DB の基盤は Core.Data（NuGet）へ集約した。名前空間を暗黙に使えるようにする -->
    <Using Include="VehicleVision.PleasanterTools.Core.Data" />
    <!-- Core.Data の共有ストアのうち、まだ切り替えていない管理者・セッションの型は、Questionnaire.Data の同名の型を使う。
         名前が重なるので、別名で固定する（暗黙の using だけだと「あいまいな参照」になる） -->
    <Using Include="VehicleVision.PleasanterTools.Questionnaire.Data.AdminUser" Alias="AdminUser" />
    <Using Include="VehicleVision.PleasanterTools.Questionnaire.Data.AdminUserStore" Alias="AdminUserStore" />
    <Using Include="VehicleVision.PleasanterTools.Questionnaire.Data.IAdminUserStore" Alias="IAdminUserStore" />
    <Using Include="VehicleVision.PleasanterTools.Questionnaire.Data.IAdminSessionStore" Alias="IAdminSessionStore" />
    <Using Include="VehicleVision.PleasanterTools.Questionnaire.Web.Services.SamlSessionKeys" Alias="SamlSessionKeys" />
  </ItemGroup>

</Project>
