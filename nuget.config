<?xml version="1.0" encoding="utf-8"?>
<!--
  NuGet のソース。
  **VehicleVision.PleasanterTools.Core.* だけを GitHub Packages から取る**（packageSourceMapping）。
  それ以外は nuget.org。マッピングが無いと、Core.* の名前を nuget.org でも探しにいく（依存の取り違えの経路になる）。

  GitHub Packages は**認証が要る**（公開リポジトリのパッケージでも、取得には read:packages のトークンが要る）。
    - CI: GITHUB_TOKEN（ワークフローの permissions に packages: read）を環境変数で渡す
    - 手元: read:packages 権限の PAT を環境変数 VEHICLEVISION_PACKAGES_TOKEN に入れる
  トークンはここへ書かない（環境変数から読む）。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="vehiclevision-github" value="https://nuget.pkg.github.com/vehiclevisionjp/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="vehiclevision-github">
      <package pattern="VehicleVision.PleasanterTools.Core.*" />
    </packageSource>
  </packageSourceMapping>
  <packageSourceCredentials>
    <vehiclevision-github>
      <add key="Username" value="%VEHICLEVISION_PACKAGES_USER%" />
      <add key="ClearTextPassword" value="%VEHICLEVISION_PACKAGES_TOKEN%" />
    </vehiclevision-github>
  </packageSourceCredentials>
</configuration>
