<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <!-- 招待の期限切れやチケットの発行から時間を進めて試すため。MIT -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <!-- 推移的依存（ITfoxtec.Identity.Saml2 経由）の脆弱性 GHSA-7hqp-7c5m-4vq6 ほか 2 件の修正版へ固定する -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\VehicleVision.PleasanterTools.Questionnaire.Web\VehicleVision.PleasanterTools.Questionnaire.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- メール送信の部品は Core.Mail（NuGet）へ集約した。名前空間を暗黙に使えるようにする -->
    <Using Include="VehicleVision.PleasanterTools.Core.Mail" />
  </ItemGroup>

  <ItemGroup>
    <!-- DB の基盤は Core.Data（NuGet）へ集約した。名前空間を暗黙に使えるようにする -->
    <Using Include="VehicleVision.PleasanterTools.Core.Data" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pleasanter のログインの本人確認は Core.Web（NuGet）へ集約した（Issue #706）。名前空間を暗黙に使えるようにする -->
    <Using Include="VehicleVision.PleasanterTools.Core.Web" />
    <Using Include="VehicleVision.PleasanterTools.Questionnaire.Web.Services.PleasanterSsoOptions" Alias="PleasanterSsoOptions" />
    <Using Include="VehicleVision.PleasanterTools.Questionnaire.Web.Services.SamlOptions" Alias="SamlOptions" />
  </ItemGroup>

</Project>