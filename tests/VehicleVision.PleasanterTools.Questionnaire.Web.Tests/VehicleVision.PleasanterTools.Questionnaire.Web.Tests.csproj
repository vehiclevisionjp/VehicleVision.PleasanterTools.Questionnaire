<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <!-- 招待の期限切れやチケットの発行から時間を進めて試すため。MIT -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <!-- 推移的依存（ITfoxtec.Identity.Saml2 経由）の脆弱性 GHSA-7hqp-7c5m-4vq6 ほか 2 件の修正版へ固定する -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\VehicleVision.PleasanterTools.Questionnaire.Web\VehicleVision.PleasanterTools.Questionnaire.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- メール送信の部品は Core.Mail（NuGet）へ集約した。名前空間を暗黙に使えるようにする -->
    <Using Include="VehicleVision.PleasanterTools.Core.Mail" />
  </ItemGroup>

  <ItemGroup>
    <!-- DB の基盤は Core.Data（NuGet）へ集約した。名前空間を暗黙に使えるようにする -->
    <Using Include="VehicleVision.PleasanterTools.Core.Data" />
    <!-- Core.Data の共有ストアのうち、まだ切り替えていない管理者・セッションの型は、Questionnaire.Data の同名の型を使う。
         名前が重なるので、別名で固定する（暗黙の using だけだと「あいまいな参照」になる） -->
    <Using Include="VehicleVision.PleasanterTools.Questionnaire.Data.AdminUser" Alias="AdminUser" />
    <Using Include="VehicleVision.PleasanterTools.Questionnaire.Data.AdminUserStore" Alias="AdminUserStore" />
    <Using Include="VehicleVision.PleasanterTools.Questionnaire.Data.IAdminUserStore" Alias="IAdminUserStore" />
    <Using Include="VehicleVision.PleasanterTools.Questionnaire.Data.IAdminSessionStore" Alias="IAdminSessionStore" />
  </ItemGroup>

</Project>