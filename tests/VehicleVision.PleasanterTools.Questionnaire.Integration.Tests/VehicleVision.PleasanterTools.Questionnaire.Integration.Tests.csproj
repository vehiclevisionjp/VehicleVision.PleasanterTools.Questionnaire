<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageReference Include="Dapper" Version="2.1.89" />
    <!-- 時間を進めて締め出しの解除を試すため。MIT -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="VehicleVision.PleasanterTools.Core.Web.Testing" Version="0.1.0-preview.11" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\VehicleVision.PleasanterTools.Questionnaire.Data\VehicleVision.PleasanterTools.Questionnaire.Data.csproj" />
    <ProjectReference Include="..\..\src\VehicleVision.PleasanterTools.Questionnaire.Pleasanter\VehicleVision.PleasanterTools.Questionnaire.Pleasanter.csproj" />
    <ProjectReference Include="..\..\src\VehicleVision.PleasanterTools.Questionnaire.Core\VehicleVision.PleasanterTools.Questionnaire.Core.csproj" />
    <ProjectReference Include="..\..\src\VehicleVision.PleasanterTools.Questionnaire.Worker\VehicleVision.PleasanterTools.Questionnaire.Worker.csproj" />
    <ProjectReference Include="..\..\src\VehicleVision.PleasanterTools.Questionnaire.Web\VehicleVision.PleasanterTools.Questionnaire.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- メール送信の部品は Core.Mail（NuGet）へ集約した。名前空間を暗黙に使えるようにする -->
    <Using Include="VehicleVision.PleasanterTools.Core.Mail" />
  </ItemGroup>

  <ItemGroup>
    <!-- DB の基盤は Core.Data（NuGet）へ集約した。名前空間を暗黙に使えるようにする -->
    <Using Include="VehicleVision.PleasanterTools.Core.Data" />
  </ItemGroup>

</Project>