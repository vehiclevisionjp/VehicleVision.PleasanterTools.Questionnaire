{
  // VS Code のタスク。**コマンドを覚えなくても回せる**ことを目的にしている。
  //
  // **資格情報の実値をここへ書かないこと。** 入っているのは検証環境用の固定値だけ
  // （App_Data/Parameters/README.md）。
  //
  // ⚠️ **args へ ${workspaceFolder} を書かないこと**（Issue #411）。
  // Windows では `D:\repos\...` に展開される。既定シェルが Git Bash だと
  // VS Code が 1 本のコマンド行へ組み立て、**bash がバックスラッシュを食べて**
  // `D:reposVehicleVision...` になり、MSB1009（プロジェクトが見つからない）で落ちる。
  // **タスクの作業ディレクトリは既定でワークスペース直下なので、相対パスで書けば足りる。**
  // options.cwd はシェルを通らないため ${workspaceFolder} のままでよい。
  "version": "2.0.0",
  "tasks": [
    {
      // **デバッグ起動はこれを通す**（Issue #421）。
      // ⚠️ **wwwroot は git で追跡していない。** .NET のビルドだけでは画面が新しくならず、
      // `git pull` しても古い画面が出続ける（実際に 1 週間気付かなかった）。
      "label": "ビルド（アプリと画面）",
      "detail": "画面を組み立ててから .NET をビルドする",
      "dependsOn": ["画面をビルドする", "ビルド"],
      "dependsOrder": "sequence",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      // **依存は無いときだけ入れる**（毎回 npm ci を回すとデバッグの開始が遅くなる）
      "label": "画面をビルドする",
      "detail": "管理画面・回答画面を .Web/wwwroot へ出す",
      "type": "shell",
      "command": "bash",
      "args": ["scripts/frontend-build.sh"],
      "problemMatcher": []
    },
    {
      "label": "ビルド",
      "detail": "ソリューション全体をビルドする（画面は含まない）",
      "type": "shell",
      "command": "dotnet",
      "args": ["build", "VehicleVision.PleasanterTools.Questionnaire.slnx"],
      "problemMatcher": "$msCompile",
      "presentation": { "reveal": "silent", "clear": true }
    },
    {
      "label": "ビルド（Release）",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "build",
        "-c",
        "Release",
        "VehicleVision.PleasanterTools.Questionnaire.slnx"
      ],
      "problemMatcher": "$msCompile"
    },

    {
      "label": "テスト（単体）",
      "detail": "結合テストを除く。**環境変数を渡さないので結合テストは中身を実行せず終わる**",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "test",
        "VehicleVision.PleasanterTools.Questionnaire.slnx",
        "--filter",
        "FullyQualifiedName!~Integration.Tests"
      ],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "テスト（結合・3 RDBMS）",
      "detail": "**先に「検証環境を起動（SQL Server）」を実行しておくこと。** DB とアプリが要る",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "test",
        "tests/VehicleVision.PleasanterTools.Questionnaire.Integration.Tests"
      ],
      "options": { "env": { "QUESTIONNAIRE_INTEGRATION": "1" } },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "テスト（結合・ウイルススキャンあり）",
      "detail": "**clamav プロファイルで起動しておくこと。** EICAR で実際に弾けるかを見る",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "test",
        "tests/VehicleVision.PleasanterTools.Questionnaire.Integration.Tests",
        "--filter",
        "FullyQualifiedName~AttachmentScanEndToEndTests"
      ],
      "options": {
        "env": { "QUESTIONNAIRE_INTEGRATION": "1", "QUESTIONNAIRE_VIRUSSCAN": "1" }
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "テスト（このファイル）",
      "detail": "開いているテストファイルのクラスだけを実行する",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "test",
        "VehicleVision.PleasanterTools.Questionnaire.slnx",
        "--filter",
        "FullyQualifiedName~${fileBasenameNoExtension}"
      ],
      "problemMatcher": "$msCompile"
    },

    {
      "label": "フロントエンド: 依存を入れる",
      "type": "shell",
      "command": "npm",
      "args": ["ci"],
      "options": {
        "cwd": "${workspaceFolder}/src/VehicleVision.PleasanterTools.Questionnaire.Frontend"
      },
      "problemMatcher": []
    },
    {
      "label": "フロントエンド: 型検査",
      "type": "shell",
      "command": "npm",
      "args": ["run", "check"],
      "options": {
        "cwd": "${workspaceFolder}/src/VehicleVision.PleasanterTools.Questionnaire.Frontend"
      },
      "problemMatcher": []
    },
    {
      "label": "フロントエンド: ビルド",
      "detail": "成果物は .Web/wwwroot へ出る",
      "type": "shell",
      "command": "npm",
      "args": ["run", "build"],
      "options": {
        "cwd": "${workspaceFolder}/src/VehicleVision.PleasanterTools.Questionnaire.Frontend"
      },
      "problemMatcher": []
    },
    {
      "label": "フロントエンド: 開発サーバ",
      "detail": "**/api は localhost:8081 へ中継される。** 検証環境を起動しておくこと",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "options": {
        "cwd": "${workspaceFolder}/src/VehicleVision.PleasanterTools.Questionnaire.Frontend"
      },
      "isBackground": true,
      "problemMatcher": []
    },

    {
      "label": "検証環境を起動（SQL Server）",
      "detail": "Pleasanter と SQL Server と本アプリ。**初回は数分かかる**",
      "type": "shell",
      "command": "docker",
      "args": ["compose", "--profile", "sqlserver", "up", "-d", "--wait"],
      "problemMatcher": []
    },
    {
      "label": "検証環境を起動（PostgreSQL）",
      "type": "shell",
      "command": "docker",
      "args": ["compose", "--profile", "postgres", "up", "-d", "--wait"],
      "problemMatcher": []
    },
    {
      "label": "検証環境を起動（MySQL）",
      "type": "shell",
      "command": "docker",
      "args": ["compose", "--profile", "mysql", "up", "-d", "--wait"],
      "problemMatcher": []
    },
    {
      "label": "検証環境を起動（ウイルススキャンあり）",
      "detail": "**clamav は定義データベースの取得が終わるまで ready にならない**（初回は数分）",
      "type": "shell",
      "command": "docker",
      "args": [
        "compose",
        "--profile",
        "sqlserver",
        "--profile",
        "clamav",
        "up",
        "-d",
        "--wait"
      ],
      "options": { "env": { "DEV_VIRUSSCAN_ENABLED": "true" } },
      "problemMatcher": []
    },
    {
      "label": "マイグレーションを当てる",
      "detail": "**アプリ起動時には当たらない**（同時実行を避けるため）。DB を替えたときは環境変数も合わせる",
      "type": "shell",
      "command": "docker",
      "args": [
        "compose", "--profile", "app", "run", "--rm", "--no-deps",
        "migrate", "--migrate", "--wait-for-db=180"
      ],
      "problemMatcher": []
    },
    {
      // **DB サーバを起こさずに当てる**（Issue #342）。
      // **アプリ起動時には当たらない**ので、SQLite で F5 する前にこれが要る
      "label": "SQLite にマイグレーションを当てる",
      "detail": "DB サーバ不要。src/....Web/App_Data/questionnaire.db へ当てる",
      "type": "shell",
      "command": "dotnet",
      // ⚠️ **下の cwd からの相対で書くこと**（Issue #413）。
      // このタスクだけ cwd を Web プロジェクトへ移しているので、
      // ワークスペース直下からの相対にすると解決できない
      "args": [
        "bin/Debug/net10.0/VehicleVision.PleasanterTools.Questionnaire.Web.dll",
        "--migrate"
      ],
      "options": {
        "cwd": "${workspaceFolder}/src/VehicleVision.PleasanterTools.Questionnaire.Web",
        "env": {
          "QUESTIONNAIRE_DB_PROVIDER": "Sqlite",
          "QUESTIONNAIRE_PLEASANTER_BASEURL": "http://localhost:8080",
          "QUESTIONNAIRE_PLEASANTER_APIKEY": "6ce6c0fd2f4aea3c093c3ebdd7d4ea3250a132b4867d68e7d1abe35c2499664abb398d74603c2b2a38e31a21319955b3c43ede30394ead7be37ddd615c34e1f6",
          // 検証環境用の固定値。**本番では必ず作り直すこと**
          "QUESTIONNAIRE_SECRET_KEY": "4S8dqZ1yq7Xh0mF2vQnQZ6dQ0kGf1o8pM3nR5tU7wYs="
        }
      },
      // SQLite の F5 はこのタスクを通るので、ここでも画面を組み立てる（Issue #421）
      "dependsOn": "ビルド（アプリと画面）",
      "problemMatcher": []
    },
    {
      "label": "マイグレーションの状態を見る",
      "detail": "当てずに、足りていないものを並べるだけ",
      "type": "shell",
      "command": "docker",
      "args": [
        "compose", "--profile", "app", "run", "--rm", "--no-deps",
        "migrate", "--migrate-status"
      ],
      "problemMatcher": []
    },
    {
      "label": "検証環境をアプリだけ作り直す",
      "detail": "コードを変えた後に使う。DB は残る",
      "type": "shell",
      "command": "docker",
      "args": ["compose", "--profile", "sqlserver", "up", "-d", "--build", "--wait", "app"],
      "problemMatcher": []
    },
    {
      "label": "検証環境を止める",
      "type": "shell",
      "command": "docker",
      "args": ["compose", "--profile", "sqlserver", "--profile", "postgres", "--profile", "mysql", "--profile", "clamav", "down"],
      "problemMatcher": []
    },
    {
      "label": "検証環境のログ（アプリ）",
      "type": "shell",
      "command": "docker",
      "args": ["compose", "logs", "-f", "app"],
      "isBackground": true,
      "problemMatcher": []
    },

    {
      "label": "smoke（動いているアプリへ当てる）",
      "detail": "配信・セキュリティヘッダ・管理画面の入口を見る",
      "type": "shell",
      "command": "bash",
      "args": ["scripts/smoke.sh"],
      "problemMatcher": []
    },
    {
      "label": "ライセンス検査",
      "detail": "**Pleasanter 本体（AGPL）への参照が混ざっていないか**を見る",
      "type": "shell",
      "command": "bash",
      "args": ["scripts/license-check.sh"],
      "problemMatcher": []
    },
    {
      "label": "秘密の鍵を作る",
      "detail": "QUESTIONNAIRE_SECRET_KEY に入れる値を作る。**失うと 2 要素が全部使えなくなる**",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "src/VehicleVision.PleasanterTools.Questionnaire.Web",
        "--",
        "--generate-secret-key"
      ],
      "problemMatcher": []
    }
  ]
}
